# Copy to config/.env and fill in. NEVER commit the real .env.
#
# Market data downloads and paper trading need none of these -- keys are only
# required for live order placement and for email alerts.

# Exchange API credentials (live trading only)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some venues (Coinbase Advanced, OKX, KuCoin) also require a passphrase:
EXCHANGE_API_PASSWORD=

# SMTP app password for email alerts. For Gmail this is an App Password,
# generated at https://myaccount.google.com/apppasswords -- not your login
# password, which will not work with SMTP.
SMTP_PASSWORD=

# Third and final live-trading safety switch. The engine refuses to place real
# orders unless this is exactly "1" AND the performance gate has passed AND
# live.mode is set to "live" in config.yaml.
# QUANTDESK_ALLOW_LIVE=1
